x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
artifacts/
publish/
publish-v*/
dist/

# Release artifacts
Palera1nWin-win-x64.zip

# Visual Studio / VS Code
.vs/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# NuGet
*.nupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
project.lock.json
project.fragment.lock.json
*.nuget.props
*.nuget.targets

# Test
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
coverage*
*.coverage
*.coveragexml

