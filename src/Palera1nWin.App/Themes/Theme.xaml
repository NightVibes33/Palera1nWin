<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

  <Color x:Key="Color.Bg">#0B1014</Color>
  <Color x:Key="Color.BgPanel">#10181F</Color>
  <Color x:Key="Color.BgElevated">#15202A</Color>
  <Color x:Key="Color.BgRaised">#1A2933</Color>
  <Color x:Key="Color.Stroke">#345063</Color>
  <Color x:Key="Color.StrokeSoft">#263946</Color>
  <Color x:Key="Color.Text">#F3F6FB</Color>
  <Color x:Key="Color.TextSecondary">#B4BED0</Color>
  <Color x:Key="Color.TextTertiary">#7F8BA1</Color>
  <Color x:Key="Color.Accent">#35D4C5</Color>
  <Color x:Key="Color.AccentDeep">#1C8CA1</Color>
  <Color x:Key="Color.AccentSoft">#123C42</Color>
  <Color x:Key="Color.Success">#4ADE80</Color>
  <Color x:Key="Color.Warning">#FACC15</Color>
  <Color x:Key="Color.Danger">#FB7185</Color>
  <Color x:Key="Color.Purple">#A78BFA</Color>
  <Color x:Key="Color.Orange">#FB923C</Color>

  <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource Color.Bg}"/>
  <SolidColorBrush x:Key="Brush.BgPanel" Color="{StaticResource Color.BgPanel}"/>
  <SolidColorBrush x:Key="Brush.BgElevated" Color="{StaticResource Color.BgElevated}"/>
  <SolidColorBrush x:Key="Brush.BgRaised" Color="{StaticResource Color.BgRaised}"/>
  <SolidColorBrush x:Key="Brush.Stroke" Color="{StaticResource Color.Stroke}"/>
  <SolidColorBrush x:Key="Brush.StrokeSoft" Color="{StaticResource Color.StrokeSoft}"/>
  <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}"/>
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}"/>
  <SolidColorBrush x:Key="Brush.TextTertiary" Color="{StaticResource Color.TextTertiary}"/>
  <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
  <SolidColorBrush x:Key="Brush.AccentDeep" Color="{StaticResource Color.AccentDeep}"/>
  <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}"/>
  <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}"/>
  <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}"/>
  <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}"/>
  <SolidColorBrush x:Key="Brush.Purple" Color="{StaticResource Color.Purple}"/>
  <SolidColorBrush x:Key="Brush.Orange" Color="{StaticResource Color.Orange}"/>

  <LinearGradientBrush x:Key="Brush.AppBackdrop" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#0A1115" Offset="0"/>
    <GradientStop Color="#102027" Offset="0.45"/>
    <GradientStop Color="#151A25" Offset="1"/>
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.CardSurface" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#DB14202A" Offset="0"/>
    <GradientStop Color="#C710171F" Offset="0.62"/>
    <GradientStop Color="#B8141C22" Offset="1"/>
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.ActionSurface" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#123342" Offset="0"/>
    <GradientStop Color="#172231" Offset="1"/>
  </LinearGradientBrush>

  <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>

  <Style x:Key="Text.Title" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Display}"/>
    <Setter Property="FontSize" Value="26"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
  </Style>

  <Style x:Key="Text.Subtitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style x:Key="Text.Section" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
  </Style>

  <Style x:Key="Text.Body" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style x:Key="Text.Caption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.TextTertiary}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style x:Key="Card.Accent" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.AccentSoft}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentDeep}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="16"/>
  </Style>

  <Style x:Key="Panel.Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.CardSurface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.StrokeSoft}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="18"/>
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect Color="#071015" BlurRadius="18" ShadowDepth="2" Opacity="0.28"/>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Panel.Raised" TargetType="Border" BasedOn="{StaticResource Panel.Card}">
    <Setter Property="Background" Value="{StaticResource Brush.BgRaised}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Stroke}"/>
  </Style>

  <Style x:Key="Panel.Action" TargetType="Border" BasedOn="{StaticResource Panel.Card}">
    <Setter Property="Background" Value="{StaticResource Brush.ActionSurface}"/>
    <Setter Property="BorderBrush" Value="#34546A"/>
  </Style>

  <Style x:Key="Badge" TargetType="Border">
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="8,3"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="Metric.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Section}">
    <Setter Property="Margin" Value="0,0,0,4"/>
  </Style>

  <Style x:Key="Metric.Value" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style TargetType="ui:Card">
    <Setter Property="Background" Value="{StaticResource Brush.CardSurface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.StrokeSoft}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="18"/>
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource Brush.BgPanel}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Stroke}"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    <Setter Property="Padding" Value="10,6"/>
  </Style>

  <Style TargetType="ListView">
    <Setter Property="Background" Value="{StaticResource Brush.BgPanel}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Stroke}"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
  </Style>

  <Style TargetType="ProgressBar">
    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
    <Setter Property="Background" Value="{StaticResource Brush.BgPanel}"/>
  </Style>

  <Style x:Key="BareListBoxItem" TargetType="ListBoxItem">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <ContentPresenter/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
