<UserControl x:Class="Palera1nWin.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding SettingsVm}">
    <StackPanel Margin="28,20,28,28" MaxWidth="820" HorizontalAlignment="Left">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="Settings" Style="{StaticResource Text.Title}"/>
        <ui:Button Grid.Column="1" Content="Save" Appearance="Primary" HorizontalAlignment="Right"
                   Command="{Binding SaveCommand}"/>
      </Grid>

      <TextBlock Text="PATHS" Style="{StaticResource Text.Section}" Margin="0,22,0,10"/>
      <ui:Card VerticalAlignment="Stretch">
        <StackPanel>
          <TextBlock Text="Toolchain root" Style="{StaticResource Text.Body}" FontWeight="Medium"/>
          <TextBox Text="{Binding ToolchainRoot, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14"/>

          <TextBlock Text="WSL distro" Style="{StaticResource Text.Body}" FontWeight="Medium"/>
          <TextBox Text="{Binding WslDistro, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14"/>

          <TextBlock Text="Selected release tag" Style="{StaticResource Text.Body}" FontWeight="Medium"/>
          <TextBox Text="{Binding SelectedReleaseTag, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/>
        </StackPanel>
      </ui:Card>

      <TextBlock Text="JAILBREAK" Style="{StaticResource Text.Section}" Margin="0,22,0,10"/>
      <ui:Card VerticalAlignment="Stretch">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Default jailbreak mode" Style="{StaticResource Text.Body}" FontWeight="Medium"/>
            <ComboBox Grid.Column="1" HorizontalAlignment="Right" MinWidth="160"
                      ItemsSource="{Binding JailbreakModes}"
                      SelectedItem="{Binding JailbreakMode, Mode=TwoWay}"/>
          </Grid>

          <Separator Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,14"/>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Safe mode" Style="{StaticResource Text.Body}" FontWeight="Medium"/>
            <ui:ToggleSwitch Grid.Column="1" HorizontalAlignment="Right" IsChecked="{Binding SafeMode}"/>
          </Grid>

          <Separator Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,14"/>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Verbose boot" Style="{StaticResource Text.Body}" FontWeight="Medium"/>
            <ui:ToggleSwitch Grid.Column="1" HorizontalAlignment="Right" IsChecked="{Binding VerboseBoot}"/>
          </Grid>

          <Separator Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,14"/>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Debug logging" Style="{StaticResource Text.Body}" FontWeight="Medium"/>
            <ui:ToggleSwitch Grid.Column="1" HorizontalAlignment="Right" IsChecked="{Binding DebugLogging}"/>
          </Grid>

          <Separator Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,14"/>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Auto-install drivers" Style="{StaticResource Text.Body}" FontWeight="Medium"/>
            <ui:ToggleSwitch Grid.Column="1" HorizontalAlignment="Right" IsChecked="{Binding AutoInstallDrivers}"/>
          </Grid>

          <Separator Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,14"/>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Prefer USB-A cable" Style="{StaticResource Text.Body}" FontWeight="Medium"/>
            <ui:ToggleSwitch Grid.Column="1" HorizontalAlignment="Right" IsChecked="{Binding PreferUsbA}"/>
          </Grid>
        </StackPanel>
      </ui:Card>

      <TextBlock Text="APPLICATION" Style="{StaticResource Text.Section}" Margin="0,22,0,10"/>
      <ui:Card VerticalAlignment="Stretch">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Check for updates at startup" Style="{StaticResource Text.Body}" FontWeight="Medium"/>
          <ui:ToggleSwitch Grid.Column="1" HorizontalAlignment="Right" IsChecked="{Binding CheckUpdates}"/>
        </Grid>
      </ui:Card>
    </StackPanel>
  </ScrollViewer>
</UserControl>
