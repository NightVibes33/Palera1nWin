<UserControl x:Class="Palera1nWin.App.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Setup}">
    <StackPanel Margin="28,20,28,28" MaxWidth="820" HorizontalAlignment="Left">
      <TextBlock Text="Setup" Style="{StaticResource Text.Title}"/>
      <TextBlock Style="{StaticResource Text.Subtitle}" Margin="0,6,0,0"
                 Text="Configure the Palera1n-Windows toolchain and validate usbipd, WSL, and drivers."/>

      <TextBlock Text="TOOLCHAIN" Style="{StaticResource Text.Section}" Margin="0,22,0,10"/>
      <ui:Card VerticalAlignment="Stretch">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" MaxWidth="520" HorizontalAlignment="Left">
            <TextBlock Text="Toolchain root" Style="{StaticResource Text.Body}" FontWeight="Medium"/>
            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,3,0,0"
                       Text="Path to Palera1n-Windows (openra1n, palera1n.cmd, scripts)."/>
            <TextBox Text="{Binding ToolchainRoot, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"/>
          </StackPanel>
          <ui:Button Grid.Column="1" Content="Browse" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Command="{Binding BrowseToolchainCommand}"/>
        </Grid>
      </ui:Card>

      <TextBlock Text="ENVIRONMENT" Style="{StaticResource Text.Section}" Margin="0,22,0,10"/>
      <ui:Card VerticalAlignment="Stretch">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" MaxWidth="520" HorizontalAlignment="Left">
              <TextBlock Text="Doctor checks" Style="{StaticResource Text.Body}" FontWeight="Medium"/>
              <TextBlock Text="{Binding DoctorSummary}" Style="{StaticResource Text.Caption}" Margin="0,3,0,0"
                         TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <ui:Button Content="Run checks" Command="{Binding RunDoctorCommand}" Margin="0,0,8,0"/>
              <ui:Button Content="Install drivers" Appearance="Primary" Command="{Binding InstallDriversCommand}"/>
            </StackPanel>
          </Grid>

          <!-- UsbDk conflict banner + uninstall button (visible only when UsbDk is detected) -->
          <Border Margin="0,14,0,0" Padding="12,10" CornerRadius="6"
                  Background="#26D83A3A"
                  Visibility="{Binding UsbDkDetected, Converter={StaticResource BoolToVis}}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" MaxWidth="520" HorizontalAlignment="Left">
                <TextBlock Text="UsbDk filter detected" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Foreground="#FFD83A3A"/>
                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                           Text="UsbDk conflicts with usbipd-win and causes attach failures. Uninstall it for a reliable jailbreak."/>
              </StackPanel>
              <ui:Button Grid.Column="1" Content="Uninstall UsbDk" Appearance="Danger"
                         HorizontalAlignment="Right" VerticalAlignment="Center"
                         Command="{Binding UninstallUsbDkCommand}"/>
            </Grid>
          </Border>

          <ItemsControl ItemsSource="{Binding DoctorChecks}" Margin="0,14,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Padding="10,8" CornerRadius="6" Margin="0,0,0,6"
                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                                 TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Badge}"
                            Background="#26343F52">
                      <TextBlock Text="{Binding StatusText}" FontSize="10.5"
                                 Foreground="{StaticResource Brush.Accent}"/>
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ui:Card>
    </StackPanel>
  </ScrollViewer>
</UserControl>
