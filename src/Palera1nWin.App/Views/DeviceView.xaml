<UserControl x:Class="Palera1nWin.App.Views.DeviceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Device}">
    <StackPanel Margin="28,20,28,28" MaxWidth="820" HorizontalAlignment="Left">
      <Grid>
        <StackPanel>
          <TextBlock Text="Device" Style="{StaticResource Text.Title}"/>
          <TextBlock Style="{StaticResource Text.Subtitle}" Margin="0,6,0,0"
                     Text="Live Apple USB device detection via WMI and usbipd."/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
          <ui:Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
          <ui:Button Content="Open Zadig" Margin="0,0,8,0" Command="{Binding OpenZadigCommand}"/>
          <ui:Button Content="Fix Windows Drivers" Appearance="Primary" Command="{Binding FixWindowsDriversCommand}"/>
        </StackPanel>
      </Grid>

      <ui:InfoBar Margin="0,18,0,0" Severity="Informational" IsOpen="True" IsClosable="False"
                  Title="Fix Windows Drivers"
                  Message="Removes libusbK/WinUSB from connected Apple devices and restores the default Apple driver so iTunes/Apple Devices can see the phone. Use this after a jailbreak session to return to normal."/>

      <ui:Card Margin="0,22,0,0" VerticalAlignment="Stretch">
        <StackPanel>
          <Grid Margin="0,0,0,12">
            <TextBlock Text="{Binding DeviceName}" Style="{StaticResource Text.Body}" FontWeight="SemiBold"/>
            <Border HorizontalAlignment="Right" Style="{StaticResource Badge}"
                    Background="{Binding ModeBadgeBackground}">
              <TextBlock Text="{Binding UsbMode}" FontSize="11" FontWeight="SemiBold"
                         Foreground="{Binding ModeBadgeForeground}"/>
            </Border>
          </Grid>

          <Grid Margin="0,0,0,8">
            <TextBlock Text="VID:PID" Style="{StaticResource Text.Caption}"/>
            <TextBlock Text="{Binding VidPid}" Style="{StaticResource Text.Body}" HorizontalAlignment="Right"/>
          </Grid>
          <Grid Margin="0,0,0,8">
            <TextBlock Text="Status" Style="{StaticResource Text.Caption}"/>
            <TextBlock Text="{Binding DeviceStatus}" Style="{StaticResource Text.Body}" HorizontalAlignment="Right"/>
          </Grid>
          <Grid Margin="0,0,0,8">
            <TextBlock Text="Driver service" Style="{StaticResource Text.Caption}"/>
            <TextBlock Text="{Binding DriverService}" Style="{StaticResource Text.Body}" HorizontalAlignment="Right"
                       TextWrapping="Wrap" MaxWidth="420" TextAlignment="Right"/>
          </Grid>
          <Grid Margin="0,0,0,8">
            <TextBlock Text="usbipd bus ID" Style="{StaticResource Text.Caption}"/>
            <TextBlock Text="{Binding BusId}" Style="{StaticResource Text.Body}" HorizontalAlignment="Right"/>
          </Grid>
          <Grid>
            <TextBlock Text="Instance ID" Style="{StaticResource Text.Caption}"/>
            <TextBlock Text="{Binding InstanceId}" Style="{StaticResource Text.Body}" HorizontalAlignment="Right"
                       TextWrapping="Wrap" MaxWidth="420" TextAlignment="Right" FontFamily="Consolas, Segoe UI"/>
          </Grid>
        </StackPanel>
      </ui:Card>
    </StackPanel>
  </ScrollViewer>
</UserControl>
