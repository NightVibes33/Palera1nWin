<UserControl x:Class="Palera1nWin.App.Views.DowngradeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Loaded="FirmwareFeatures_Loaded">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,20,28,32" MaxWidth="1120" HorizontalAlignment="Left">
      <Grid>
        <StackPanel>
          <TextBlock Text="Downgrade" Style="{StaticResource Text.Title}"/>
          <TextBlock Style="{StaticResource Text.Subtitle}" Margin="0,6,0,0"
                     Text="Device-aware iOS and iPadOS 15 firmware downloads, guided DFU entry, tethered restore, and tether boot."/>
        </StackPanel>
        <Border x:Name="DeviceModeBadge" HorizontalAlignment="Right" VerticalAlignment="Top"
                Style="{StaticResource Badge}" Background="#26343F52">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="DeviceDot" Width="7" Height="7" Margin="0,0,7,0"
                     VerticalAlignment="Center" Fill="{StaticResource Brush.TextTertiary}"/>
            <TextBlock x:Name="DeviceModeLabel" Text="Disconnected" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
          </StackPanel>
        </Border>
      </Grid>

      <ui:InfoBar Margin="0,20,0,0" Severity="Warning" IsOpen="True" IsClosable="False"
                  Title="A tethered downgrade erases the device and requires a computer for every cold boot"
                  Message="Back up first. Activation Lock is not removed. Keep the generated session files and boot assets backed up."/>

      <TextBlock Text="CONNECTED DEVICE &amp; IOS 15 IPSW DOWNLOADER"
                 Style="{StaticResource Text.Section}" Margin="0,22,0,10"/>
      <ui:Card>
        <StackPanel>
          <Grid>
            <StackPanel>
              <TextBlock x:Name="FirmwareDeviceText" Text="No exact device detected"
                         Style="{StaticResource Text.Body}" FontWeight="SemiBold"/>
              <TextBlock x:Name="FirmwareSupportText"
                         Text="Connect a supported device in normal, recovery, or DFU mode. The app never asks you to choose a model manually."
                         Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <ui:Button x:Name="RefreshFirmwareButton" Content="Refresh Device &amp; Firmware"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Click="RefreshFirmware_Click"/>
          </Grid>

          <ListView x:Name="FirmwareList" Margin="0,16,0,0" MinHeight="190" MaxHeight="300"
                    SelectionChanged="FirmwareSelectionChanged"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" Background="{DynamicResource ControlFillColorSecondaryBrush}">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Version" Width="105" DisplayMemberBinding="{Binding Version}"/>
                <GridViewColumn Header="Build" Width="105" DisplayMemberBinding="{Binding BuildId}"/>
                <GridViewColumn Header="Signing" Width="105" DisplayMemberBinding="{Binding SigningStatus}"/>
                <GridViewColumn Header="Released" Width="145" DisplayMemberBinding="{Binding ReleaseDateText}"/>
                <GridViewColumn Header="Size" Width="95" DisplayMemberBinding="{Binding SizeText}"/>
                <GridViewColumn Header="Exact device" Width="155" DisplayMemberBinding="{Binding Identifier}"/>
                <GridViewColumn Header="SHA-1" Width="250" DisplayMemberBinding="{Binding Sha1}"/>
              </GridView>
            </ListView.View>
          </ListView>

          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <TextBlock x:Name="FirmwareDownloadStatusText"
                         Text="Waiting for a supported device"
                         Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>
              <ProgressBar x:Name="FirmwareDownloadProgress" Minimum="0" Maximum="100"
                           Height="6" Margin="0,7,14,0" Visibility="Collapsed"/>
            </StackPanel>
            <ui:Button x:Name="CancelFirmwareDownloadButton" Grid.Column="1" Content="Cancel"
                       Appearance="Transparent" IsEnabled="False" Margin="8,0,0,0"
                       Click="CancelFirmwareDownload_Click"/>
            <ui:Button x:Name="DownloadFirmwareButton" Grid.Column="2" Content="Download &amp; Use IPSW"
                       Appearance="Primary" IsEnabled="False" Margin="8,0,0,0"
                       Click="DownloadFirmware_Click"/>
          </Grid>
        </StackPanel>
      </ui:Card>

      <Grid Margin="0,20,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ui:Card Grid.Column="0" Margin="0,0,10,0">
          <StackPanel>
            <TextBlock Text="Selected firmware" Style="{StaticResource Text.Body}" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,14"
                       Text="Downloaded firmware is selected automatically. Browse remains available for an untouched Apple IPSW obtained elsewhere."/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="IpswPathBox" Grid.Column="0" IsReadOnly="True" MinHeight="34"
                       VerticalContentAlignment="Center" Text="No IPSW selected"/>
              <ui:Button Grid.Column="1" Content="Browse" Margin="8,0,0,0" Padding="16,7"
                         Click="BrowseIpsw_Click"/>
              <ui:Button x:Name="InspectIpswButton" Grid.Column="2" Content="Inspect" Margin="8,0,0,0"
                         Padding="16,7" Appearance="Primary" Click="InspectIpsw_Click"/>
            </Grid>
            <Border Margin="0,14,0,0" Padding="12" CornerRadius="6"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
              <TextBlock x:Name="IpswSummaryText" Style="{StaticResource Text.Caption}"
                         Text="Select an IPSW to verify its ProductType, version, manifest, size, and SHA-256."
                         TextWrapping="Wrap"/>
            </Border>
          </StackPanel>
        </ui:Card>

        <ui:Card Grid.Column="1" Margin="10,0,0,0">
          <StackPanel>
            <TextBlock Text="Readiness" Style="{StaticResource Text.Body}" FontWeight="SemiBold"/>
            <TextBlock Text="DEVICE" Style="{StaticResource Text.Section}" Margin="0,16,0,4"/>
            <TextBlock x:Name="DeviceDetailsText" Text="Connect a supported Apple device"
                       Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>
            <Separator Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,14"/>
            <TextBlock Text="TOOLCHAIN" Style="{StaticResource Text.Section}"/>
            <TextBlock x:Name="ToolchainStateText" Text="Checking" Style="{StaticResource Text.Body}"
                       FontWeight="SemiBold" Margin="0,5,0,0"/>
            <TextBlock x:Name="ToolchainDetailsText" Text="Validating packaged components"
                       Style="{StaticResource Text.Caption}" Margin="0,3,0,0" TextWrapping="Wrap"/>
            <ui:Button Content="Run Diagnostics" Margin="0,16,0,0" HorizontalAlignment="Left"
                       Click="RunDiagnostics_Click"/>
          </StackPanel>
        </ui:Card>
      </Grid>

      <TextBlock Text="SUPPORTED DEVICES" Style="{StaticResource Text.Section}" Margin="0,22,0,10"/>
      <ui:Card>
        <StackPanel>
          <TextBlock Text="Official turdus device range: Apple A9 through A10X"
                     Style="{StaticResource Text.Body}" FontWeight="SemiBold"/>
          <TextBlock x:Name="SupportedDevicesText" Style="{StaticResource Text.Caption}"
                     Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="20"/>
          <ui:InfoBar Margin="0,14,0,0" Severity="Informational" IsOpen="True" IsClosable="False"
                      Title="Backend status"
                      Message="Firmware detection, iOS/iPadOS 15 downloads, inspection, and DFU guidance cover the complete A9-A10X list. The native Windows SHC/PTE restore and tether-boot path is enabled for A9/A9X; A10/A10X requires its separate iBoot/SEP tether-boot backend and is not silently routed through the A9 sequence."/>
        </StackPanel>
      </ui:Card>

      <TextBlock Text="GUIDED DFU MODE" Style="{StaticResource Text.Section}" Margin="0,22,0,10"/>
      <ui:Card>
        <StackPanel>
          <Grid>
            <StackPanel>
              <TextBlock x:Name="DfuGuideTitle" Text="Connect a supported device"
                         Style="{StaticResource Text.Body}" FontWeight="SemiBold"/>
              <TextBlock x:Name="DfuGuideStepsText"
                         Text="The exact button sequence appears after ProductType detection. iPhone 7 and 7 Plus use Volume Down; other supported devices use Home."
                         Style="{StaticResource Text.Caption}" Margin="0,5,0,0"
                         TextWrapping="Wrap" LineHeight="20"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
              <ui:Button x:Name="CancelDfuGuideButton" Content="Cancel Guide" Appearance="Transparent"
                         IsEnabled="False" Click="CancelDfuGuide_Click"/>
              <ui:Button x:Name="StartDfuGuideButton" Content="Start Timed DFU Guide" Appearance="Primary"
                         IsEnabled="False" Margin="8,0,0,0" Click="StartDfuGuide_Click"/>
            </StackPanel>
          </Grid>
          <Border Margin="0,14,0,0" Padding="12" CornerRadius="6"
                  Background="{DynamicResource ControlFillColorSecondaryBrush}"
                  BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel>
              <TextBlock x:Name="DfuGuideStatusText" Text="Ready when a supported device is detected"
                         Style="{StaticResource Text.Caption}" FontWeight="SemiBold"/>
              <ProgressBar x:Name="DfuGuideProgress" Minimum="0" Maximum="100" Height="7" Margin="0,9,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ui:Card>

      <TextBlock Text="COMPLETE WORKFLOW" Style="{StaticResource Text.Section}" Margin="0,22,0,10"/>
      <ui:Card>
        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" LineHeight="21">
          <Run FontWeight="SemiBold" Text="1. Prepare — "/><Run Text="Install Apple Devices or desktop iTunes, use a direct Lightning cable, make a backup, and know the Apple ID used by Activation Lock.&#x0a;"/>
          <Run FontWeight="SemiBold" Text="2. Detect — "/><Run Text="Connect and unlock the device in normal mode when possible. The app reads ProductType automatically and refuses manual model guessing.&#x0a;"/>
          <Run FontWeight="SemiBold" Text="3. Download — "/><Run Text="Choose an iOS/iPadOS 15 build returned for that exact ProductType. Signed and unsigned status is informational; the tethered method does not require the target IPSW to be currently signed.&#x0a;"/>
          <Run FontWeight="SemiBold" Text="4. Inspect — "/><Run Text="Verify the IPSW manifest and confirm it contains the connected ProductType before any destructive action is enabled.&#x0a;"/>
          <Run FontWeight="SemiBold" Text="5. Enter DFU — "/><Run Text="Use the timed guide. A black screen is required; a cable/computer image means Recovery Mode, not DFU.&#x0a;"/>
          <Run FontWeight="SemiBold" Text="6. Restore — "/><Run Text="The app prepares pwned DFU, performs the tethered restore, stores generated boot assets, and records every stage in the session folder.&#x0a;"/>
          <Run FontWeight="SemiBold" Text="7. Boot later — "/><Run Text="After shutdown, restart, or a dead battery, reconnect the same device, enter DFU again, and use Tether Boot with its saved device-specific assets."/>
        </TextBlock>
      </ui:Card>

      <TextBlock Text="RESTORE PROGRESS" Style="{StaticResource Text.Section}" Margin="0,22,0,10"/>
      <ui:Card>
        <StackPanel>
          <Grid>
            <StackPanel>
              <TextBlock x:Name="CurrentStageText" Text="Ready" Style="{StaticResource Text.Body}" FontWeight="SemiBold"/>
              <TextBlock x:Name="CurrentDetailText" Text="Detect a device and select an inspected IPSW"
                         Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <ui:Button x:Name="CancelButton" Content="Cancel" Appearance="Transparent"
                       HorizontalAlignment="Right" VerticalAlignment="Center" IsEnabled="False"
                       Click="Cancel_Click"/>
          </Grid>
          <ProgressBar x:Name="OperationProgress" Minimum="0" Maximum="100" Height="8" Margin="0,14,0,0"/>
        </StackPanel>
      </ui:Card>

      <Grid Margin="0,20,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3*"/>
          <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <ui:Card Grid.Column="0" Margin="0,0,10,0">
          <StackPanel>
            <TextBlock Text="Full tethered downgrade" Style="{StaticResource Text.Body}" FontWeight="SemiBold"/>
            <TextBlock x:Name="RestoreCapabilityText" Style="{StaticResource Text.Caption}" Margin="0,4,0,14"
                       Text="Connect a supported device to determine the correct chip-specific restore path."
                       TextWrapping="Wrap"/>
            <CheckBox x:Name="EraseCheck" Content="I understand this completely erases the connected device"
                      Margin="0,0,0,9" Checked="ConfirmationChanged" Unchecked="ConfirmationChanged"/>
            <CheckBox x:Name="TetherCheck" Content="I understand every cold boot requires this Windows app"
                      Margin="0,0,0,9" Checked="ConfirmationChanged" Unchecked="ConfirmationChanged"/>
            <CheckBox x:Name="OwnershipCheck" Content="I own or am authorized to restore this device"
                      Checked="ConfirmationChanged" Unchecked="ConfirmationChanged"/>
            <ui:Button x:Name="StartDowngradeButton" Content="Start Full Downgrade" Appearance="Primary"
                       Padding="22,10" Margin="0,18,0,0" HorizontalAlignment="Left" IsEnabled="False"
                       Click="StartDowngrade_Click"/>
          </StackPanel>
        </ui:Card>

        <ui:Card Grid.Column="1" Margin="10,0,0,0">
          <StackPanel>
            <TextBlock Text="Tether boot" Style="{StaticResource Text.Body}" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,14"
                       Text="Use the boot asset saved by a completed downgrade session after shutdown or restart."/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="PtePathBox" Grid.Column="0" IsReadOnly="True" MinHeight="34"
                       VerticalContentAlignment="Center" Text="No boot asset selected"/>
              <ui:Button Grid.Column="1" Content="Browse" Margin="8,0,0,0" Click="BrowsePte_Click"/>
            </Grid>
            <ui:Button x:Name="TetherBootButton" Content="Tether Boot" Appearance="Secondary"
                       Padding="22,10" Margin="0,18,0,0" HorizontalAlignment="Left" IsEnabled="False"
                       Click="TetherBoot_Click"/>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
              <ui:Button Content="Sessions" Appearance="Transparent" Click="OpenSessions_Click"/>
              <ui:Button Content="Logs" Appearance="Transparent" Margin="8,0,0,0" Click="OpenLogs_Click"/>
            </StackPanel>
          </StackPanel>
        </ui:Card>
      </Grid>

      <TextBlock Text="DIAGNOSTICS" Style="{StaticResource Text.Section}" Margin="0,22,0,10"/>
      <ui:Card>
        <TextBox x:Name="DiagnosticsBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="100" MaxHeight="200" VerticalScrollBarVisibility="Auto"
                 BorderThickness="0" Background="Transparent" FontFamily="Consolas, Cascadia Mono, Segoe UI"
                 FontSize="11.5" Text="Run diagnostics to check administrator rights, disk space, exact ProductType, device mode, and packaged components."/>
      </ui:Card>

      <TextBlock Text="DARKSWORD LOG" Style="{StaticResource Text.Section}" Margin="0,22,0,10"/>
      <ui:Card>
        <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="150" MaxHeight="280" VerticalScrollBarVisibility="Auto"
                 BorderThickness="0" Background="Transparent" FontFamily="Consolas, Cascadia Mono, Segoe UI"
                 FontSize="11.5"/>
      </ui:Card>
    </StackPanel>
  </ScrollViewer>
</UserControl>
