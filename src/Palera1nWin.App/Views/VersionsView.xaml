<UserControl x:Class="Palera1nWin.App.Views.VersionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Versions}">
    <StackPanel Margin="28,20,28,28" MaxWidth="920" HorizontalAlignment="Left">
      <Grid>
        <StackPanel>
          <TextBlock Text="Versions" Style="{StaticResource Text.Title}"/>
          <TextBlock Style="{StaticResource Text.Subtitle}" Margin="0,6,0,0"
                     Text="Fetch palera1n releases from GitHub and download the Linux binary for WSL."/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
          <ui:Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
          <ui:Button Content="Download selected" Appearance="Primary" Command="{Binding DownloadCommand}"/>
        </StackPanel>
      </Grid>

      <ui:InfoBar Margin="0,18,0,0" Severity="Informational" IsOpen="True" IsClosable="False"
                  Title="Bundled toolchain"
                  Message="{Binding BundledVersionNote}"/>

      <TextBlock Style="{StaticResource Text.Caption}" Margin="0,14,0,4"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                 Text="Click a release below to select it, then choose Download selected."/>
      <TextBlock Text="{Binding DownloadStatus}" Style="{StaticResource Text.Caption}" Margin="0,0,0,10"/>

      <ui:Card VerticalAlignment="Stretch">
        <ListBox ItemsSource="{Binding Releases}"
                 SelectedItem="{Binding SelectedRelease, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource BareListBoxItem}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MinHeight="320">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border x:Name="CardBorder"
                      Padding="10,8" CornerRadius="6" Margin="0,0,0,4"
                      Background="{DynamicResource ControlFillColorDefaultBrush}"
                      BorderBrush="Transparent" BorderThickness="2">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Text.Body}" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0">
                      <Run Text="{Binding TagName, Mode=OneWay}"/>
                      <Run Text="  ·  "/>
                      <Run Text="{Binding PublishedText, Mode=OneWay}"/>
                      <Run Text="  ·  "/>
                      <Run Text="{Binding AssetName, Mode=OneWay}"/>
                      <Run Text="  ·  "/>
                      <Run Text="{Binding SizeText, Mode=OneWay}"/>
                    </TextBlock>
                    <Border x:Name="PongoBadge" Style="{StaticResource Badge}"
                            HorizontalAlignment="Left" Margin="0,6,0,0"
                            Background="{StaticResource Brush.StrokeSoft}"
                            ToolTip="{Binding Pongo.Summary}">
                      <TextBlock x:Name="PongoBadgeLabel" Text="{Binding PongoBadgeText}"
                                 FontSize="10.5" FontWeight="SemiBold"
                                 Foreground="{StaticResource Brush.TextTertiary}"/>
                    </Border>
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="&#xE73E;" FontFamily="{StaticResource Font.Icons}"
                             FontSize="18" VerticalAlignment="Center" Margin="12,0,0,0"
                             Foreground="{StaticResource Brush.Accent}"
                             Visibility="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected, Converter={StaticResource BoolToVis}}"/>
                </Grid>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                  <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                  <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                  <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource Brush.AccentSoft}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding PongoIsWarning}" Value="True">
                  <Setter TargetName="PongoBadge" Property="Background" Value="{StaticResource Brush.Warning}"/>
                  <Setter TargetName="PongoBadgeLabel" Property="Foreground" Value="{StaticResource Brush.Bg}"/>
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </ui:Card>
    </StackPanel>
  </ScrollViewer>
</UserControl>
